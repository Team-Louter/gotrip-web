# 기본값: 실제 서버. UI 데모가 필요할 때만 true로 변경합니다.
VITE_CHAT_USE_MOCK=false
# 개발: Vite /api 프록시 대상. 배포: API 요청 주소 (CORS 허용 필요).
# 배포에서 같은 origin의 /api 및 /backend 역방향 프록시를 사용할 경우 빈 값으로 설정합니다.
VITE_API_BASE_URL=https://api-gotrip.prot.kr
# 운영 Swagger 인증 경로. 저장소의 로컬 dev:auth 서버를 쓸 때는 /api/auth로 변경합니다.
VITE_AUTH_API_PREFIX=/api/members
